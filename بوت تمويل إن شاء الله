from telegram import Update from telegram.ext import Updater, CommandHandler, CallbackContext # رصيد كل مستخدم مخزن في الذاكرة user_balances = {} def start(update: Update, context: CallbackContext): update.message.reply_text( "مرحبًا! هذا بوت التمويل الخاص بك.\n" "الأوامر:\n" "/add <المبلغ> - إضافة رصيد\n" "/spend <المبلغ> - تسجيل مصروف\n" "/balance - معرفة الرصيد" ) def add(update: Update, context: CallbackContext): user_id = update.message.from_user.id try: amount = float(context.args[0]) except (IndexError, ValueError): update.message.reply_text("الرجاء كتابة المبلغ بشكل صحيح، مثال: /add 100") return user_balances[user_id] = user_balances.get(user_id, 0) + amount update.message.reply_text(f"تمت إضافة {amount} إلى رصيدك.\nالرصيد الحالي: {user_balances[user_id]}") def spend(update: Update, context: CallbackContext): user_id = update.message.from_user.id try: amount = float(context.args[0]) except (IndexError, ValueError): update.message.reply_text("الرجاء كتابة المبلغ بشكل صحيح، مثال: /spend 50") return current = user_balances.get(user_id, 0) if current < amount: update.message.reply_text("الرصيد غير كافي لإتمام العملية.") else: user_balances[user_id] -= amount update.message.reply_text(f"تم خصم {amount} من رصيدك.\nالرصيد الحالي: {user_balances[user_id]}") def balance(update: Update, context: CallbackContext): user_id = update.message.from_user.id update.message.reply_text(f"رصيدك الحالي: {user_balances.get(user_id, 0)}") def main(): TOKEN = "8436509107:AAE-gh9Av5aWmFzBvqqJz5K4Fmss-5V_Bg8" updater = Updater(TOKEN) dp = updater.dispatcher dp.add_handler(CommandHandler("start", start)) dp.add_handler(CommandHandler("add", add)) dp.add_handler(CommandHandler("spend", spend)) dp.add_handler(CommandHandler("balance", balance)) updater.start_polling() updater.idle() if name == "main": main()
